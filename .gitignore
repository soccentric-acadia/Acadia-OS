# ─── Yocto build output ───────────────────────────────────────────────────────
build/
cache/

# ─── Local layer clones (never commit; kas fetches layers) ────────────────────
# meta-webconfig is provided via meta-acadia's webconfigd.bb, which fetches
# Acadia-Configuration directly. A vendored copy here is a duplication hazard.
meta/meta-webconfig/

# ─── KAS artefacts ────────────────────────────────────────────────────────────
.kas-cache/
kas-container

# ─── Yocto / BitBake generated files ─────────────────────────────────────────
# Cloned upstream layers (managed by KAS, never edited by hand)
layers/

# BitBake lock and pseudo database
bitbake.lock
pseudodone

# SDK installers
deploy/**/*.sh

# Compiled Python
*.pyc
*.pyo
__pycache__/

# ─── Docker artefacts ─────────────────────────────────────────────────────────
*.tar
*.tar.gz

# ─── SD card images (large) ───────────────────────────────────────────────────
*.wic
*.wic.bz2
*.wic.bmap
*.img
*.img.bz2

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log

deploy/
# meta/ holds the meta-acadia Yocto layer, now fetched by kas from its own
# upstream (soccentric-acadia/meta-acadia) and checked out here as a nested
# clone — never tracked in this repo.
meta/*
