# Raspberry Pi 5 SD card image — A/B OTA layout  (optimised for 256 GB card)
#
# p1  /boot       256 MB   FAT32  kernel, DTBs, config.txt, cmdline.txt
# p2  /           16 GB    ext4   rootfs-a  (active slot, populated at build time)
# p3  <none>      16 GB    ext4   rootfs-b  (standby slot, written by SWUpdate)
# p4  /home       512 MB → grows to fill card on first boot via rpi5-home-init
#
# p2/p3 are sized at 16 GB to accommodate the gRPC + SWUpdate + dashboard
# stack with headroom for future package growth.  Issue #28: only ONE
# first-boot service resizes partitions (rpi5-home-init, growing p4 to
# 100% of disk).  p2 and p3 are static — no grow-to-fill on the A/B
# rootfs slots.
#
# p4 is mounted at /home so user home directories (e.g. /home/rpi) persist
# across OTA updates.  On first boot, rpi5-home-init.service creates /home/rpi
# because the fresh empty partition hides the in-rootfs skeleton copy.
#
# SWUpdate writes the new rootfs to the inactive slot (p2 or p3) and
# updates /boot/cmdline.txt to point root= at the new PARTUUID.
# On the next reboot the updated slot becomes active.

part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --fixed-size 256M

part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfs-a --align 4096 --fixed-size 16G

part --source empty --ondisk mmcblk0 --fstype=ext4 --label rootfs-b --align 4096 --fixed-size 16G

# p4 is created at 512 MB here so the .wic image stays small.
# rpi5-home-init.service expands it to fill the actual card on first boot.
# This is the ONLY partition that grows on first boot — issue #28.
part /home --source empty --ondisk mmcblk0 --fstype=ext4 --label home --align 4096 --fixed-size 512M
